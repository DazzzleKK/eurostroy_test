# copy to .env and fill in

# --- backend ---
DATABASE_URL=postgresql+asyncpg://catalog:catalog@postgres:5432/catalog
DB_POOL_SIZE=5
DB_POOL_TIMEOUT=10

# --- postgres container ---
POSTGRES_DB=catalog
POSTGRES_USER=catalog
POSTGRES_PASSWORD=catalog

# --- published ports ---
# меняйте, если порт занят другим проектом
BACKEND_PORT=8000
FRONTEND_PORT=3000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
GATEWAY_PORT=8080

# --- minio ---
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=catalog
S3_SECURE=false
S3_REGION=us-east-1
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- telegram ---
BOT_TOKEN=
# random string, Telegram sends it back in X-Telegram-Bot-Api-Secret-Token
BOT_WEBHOOK_SECRET=change-me
# public https url of the backend, e.g. https://catalog.example.com
PUBLIC_API_URL=http://localhost:8000
# public https url of the frontend, used by the Mini App button
WEBAPP_URL=http://localhost:3000
# comma separated telegram user ids allowed to create products
ADMIN_IDS=

# --- frontend ---
# where next.js server-side requests go
BACKEND_INTERNAL_URL=http://backend:8000
